struct StringBuilder {
    handle: string
}


fn sb_new(): StringBuilder {
    return StringBuilder { handle: __std_sb_new() }
}


fn sb_append(sb: StringBuilder, s: string): StringBuilder {
    return StringBuilder { handle: __std_sb_append(sb.handle, s) }
}


fn sb_append_line(sb: StringBuilder, s: string): StringBuilder {
    let handle = __std_sb_append(sb.handle, s)
    return StringBuilder { handle: __std_sb_append(handle, "\n") }
}


fn sb_string(sb: StringBuilder): string {
    return __std_sb_string(sb.handle)
}


fn sb_len(sb: StringBuilder): int {
    return __std_sb_len(sb.handle)
}


fn sb_clear(sb: StringBuilder): StringBuilder {
    return StringBuilder { handle: __std_sb_clear(sb.handle) }
}
